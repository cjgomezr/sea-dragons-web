# Variables de entorno de Victoria Seadragons.
#
# Ninguna aqui tiene un valor real: cada placeholder dice de donde sacar el
# valor verdadero. Copia este archivo a .env.local y rellenalo; .env.local
# nunca se commitea. Que entorno (local, preview, produccion, CI) usa cada
# variable y quien la pone esta en docs/entornos.md.

# --- Supabase (proyecto de desarrollo: seadragons-dev, Sidney) ---

# URL del proyecto de Supabase. Lleva NEXT_PUBLIC_ a proposito: es un
# endpoint publico, no una credencial (ver src/lib/supabase/config.ts).
# De donde se saca: Supabase Dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave anonima de Supabase. Tambien publica a proposito: cualquier consulta
# hecha con ella queda sujeta a RLS.
# De donde se saca: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplaza-con-la-anon-key-de-supabase

# Llave de servicio de Supabase. Salta RLS: solo se usa en codigo de
# servidor, nunca en un componente de cliente ni con el prefijo
# NEXT_PUBLIC_ (ver src/lib/supabase/service-client.ts).
# De donde se saca: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=reemplaza-con-la-service-role-key-de-supabase

# Token personal de Supabase para el CLI y el MCP: ve todas tus
# organizaciones, a diferencia de un token de proyecto. Necesario para
# aplicar migraciones o usar el comando `supabase` en tu maquina.
# De donde se saca: https://supabase.com/dashboard/account/tokens (token personal, cuenta completa, no de proyecto).
SUPABASE_ACCESS_TOKEN=reemplaza-con-tu-token-personal-de-supabase

# --- Tests end-to-end y visuales (Playwright) ---

# URL base contra la que corren los tests de Playwright y el preflight de UI
# (scripts/ui-preflight.sh).
# De donde se saca: no hace falta ponerla en local, usa el valor por defecto;
# en CI la fija el workflow con la URL del servidor que acaba de levantar.
APP_URL=http://localhost:3417

# La pone automaticamente el proveedor de CI (GitHub Actions, Vercel): activa
# reintentos y el reporter "github" en playwright.config.ts. Nunca se
# configura a mano ni se pone en .env.local.
CI=

# Reusa un dev server que ya este corriendo en vez de que Playwright levante
# uno nuevo. Solo para desarrollo local.
# De donde se saca: la decides tu; ponla en 1 cuando ya tengas `npm run dev` arriba.
FABRICA_REUSE_SERVER=0

# Retraso simulado (en milisegundos) del "dev server" falso que usa el
# fixture de tests/unit/scripts/ui-preflight.test.ts para probar el
# preflight. Solo existe dentro de ese test; no hace falta para desarrollo
# normal.
START_DELAY_MS=0

# Postgres desechable contra el que corren los tests del aplicador de
# migraciones (tests/unit/scripts/apply-migrations.test.ts): crean y destruyen
# bases desde esta conexión. Sin ella esos tests se saltan solos, que es lo
# correcto en una máquina sin Postgres. NUNCA un proyecto de Supabase: esos
# tests borran bases. En CI la pone .github/workflows/migrations.yml apuntando
# al Postgres efímero del runner.
MIGRATIONS_TEST_DATABASE_URL=
# Sólo la pone migrations.yml, a 1: convierte "no hay Postgres" en un fallo en
# vez de un salto, para que esa corrida no se lea verde sin haber probado
# ninguna migración. En local se deja vacía.
REQUIRE_MIGRATIONS_POSTGRES=
