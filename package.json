    "ui:screenshots": "node --experimental-strip-types scripts/capture-ui.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.2",
