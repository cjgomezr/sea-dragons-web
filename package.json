{
  "name": "sea-dragons-web",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web del club Victoria Seadragons (rugby subacuático, Melbourne).",
  "scripts": {
    "dev": "next dev -p 3417",
    "build": "next build",
    "start": "next start -p 3417",
    "test": "vitest run",
